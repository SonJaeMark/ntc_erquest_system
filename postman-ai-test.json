{
  "info": {
    "_postman_id": "7f497680-9be7-4d32-9eb5-7bc3a8b1f301",
    "name": "NTC ERQuest AI Test",
    "description": "Postman collection for login and AiChatBotController testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://ntc-erquest-system-omyz.onrender.com"
    },
    {
      "key": "email",
      "value": "student1@email.com"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('accessToken exists', function () {",
                  "  pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.collectionVariables.set('accessToken', json.accessToken || '');",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken || '');",
                  "pm.collectionVariables.set('userId', json.userId ? String(json.userId) : '');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Ask AI Chatbot",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.collectionVariables.get('accessToken');",
                  "if (!token) {",
                  "  throw new Error('Missing accessToken. Run Login first.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('AI request should not be unauthorized', function () {",
                  "  pm.expect(pm.response.code).to.not.eql(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What documents are required for OJT?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ai/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ai",
                "ask"
              ]
            }
          }
        }
      ]
    }
  ]
}
