                "exec": [
                  "console.log('\\n=== REGISTER STUDENT USER ===');",
                  "console.log('Status Code: ' + pm.response.code);",
                  "console.log('Response Time: ' + pm.response.responseTime + 'ms');",
                  "",
                  "if (pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  console.log('Student User ID: ' + jsonData.id);",
                  "  console.log('Email: ' + jsonData.email);",
                  "  console.log('First Name: ' + jsonData.firstName);",
                  "  console.log('Last Name: ' + jsonData.lastName);",
                  "  pm.environment.set('student_user_id', jsonData.id);",
                  "  pm.environment.set('student_email', jsonData.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student{{$randomInt}}.test@example.com\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Student\",\n  \"role\": \"STUDENT\"\n}"
